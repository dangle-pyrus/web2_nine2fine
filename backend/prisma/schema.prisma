generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MembershipTier {
  membership_tier_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier_name          String   @unique @db.VarChar(50)
  minSpending        Decimal  @default(0) @map("min_spending") @db.Decimal(12, 2)
  max_spending       Decimal? @db.Decimal(12, 2)
  benefits           String?
  is_active          Boolean  @default(true)

  @@map("membership_tiers")
}

model User {
  user_id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_tier_id String?   @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  phone_number       String?   @db.VarChar(20)
  gender             String?   @db.VarChar(20)
  loyal_points       Int       @default(0)
  role               user_role @default(member)
  isActive           Boolean   @default(true) @map("is_active")
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  terms_accepted_at  DateTime  @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("users")
}

model Address {
  address_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone_number  String   @db.VarChar(20)
  street        String   @db.VarChar(255)
  district      String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("addresses")
}

model AuthActionToken {
  token_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?       @db.Uuid
  email          String        @db.VarChar(255)
  tokenHash      String        @map("token_hash") @db.VarChar(255)
  purpose        token_purpose
  expiresAt      DateTime      @map("expires_at") @db.Timestamp(6)
  used_at        DateTime?     @db.Timestamp(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  attempts       Int           @default(0)
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamp(6)
  invalidated_at DateTime?     @db.Timestamp(6)

  @@index([email, purpose], map: "idx_auth_tokens_email_purpose")
  @@map("auth_action_tokens")
}

model LoginAttempt {
  email        String    @db.VarChar(255)
  deviceId     String    @map("device_id") @db.VarChar(100)
  failed_count Int       @default(0)
  lockedUntil  DateTime? @map("locked_until") @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)

  @@id([email, deviceId])
  @@map("login_attempts")
}

model Session {
  session_id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  deviceId         String      @map("device_id") @db.VarChar(100)
  refreshTokenHash String      @unique @map("refresh_token_hash") @db.VarChar(255)
  login_method     auth_method
  userAgent        String?     @map("user_agent") @db.VarChar(500)
  ipAddress        String?     @map("ip_address") @db.VarChar(45)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  last_used_at     DateTime    @default(now()) @db.Timestamp(6)
  expiresAt        DateTime    @map("expires_at") @db.Timestamp(6)
  revoked_at       DateTime?   @db.Timestamp(6)
  revoke_reason    String?     @db.VarChar(50)

  @@index([deviceId], map: "idx_sessions_device_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([userId, deviceId], map: "idx_sessions_user_device")
  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

enum Role {
  MEMBER
  STAFF
  ADMIN
}

enum auth_method {
  password
  otp
}

enum token_purpose {
  register
  login
  reset_password
  guest_order_lookup
}

enum user_role {
  member
  admin
  staff
}
