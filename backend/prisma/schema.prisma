generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MembershipTier {
  membership_tier_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tier_name          String   @unique @db.VarChar(50)
  minSpending        Decimal  @default(0) @map("min_spending") @db.Decimal(12, 2)
  max_spending       Decimal? @db.Decimal(12, 2)
  benefits           String?
  is_active          Boolean  @default(true)

  @@map("membership_tiers")
}

model User {
  user_id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membership_tier_id String?   @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  phone_number       String?   @db.VarChar(20)
  gender             String?   @db.VarChar(20)
  loyal_points       Int       @default(0)
  role               user_role @default(member)
  isActive           Boolean   @default(true) @map("is_active")
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  marketingOptInAt   DateTime? @map("marketing_opt_in_at") @db.Timestamp(6)
  terms_accepted_at  DateTime  @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("users")
}

model Address {
  address_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone_number  String   @db.VarChar(20)
  street        String   @db.VarChar(255)
  district      String   @db.VarChar(100)
  city          String   @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("addresses")
}

model AuthActionToken {
  token_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String?       @db.Uuid
  email          String        @db.VarChar(255)
  tokenHash      String        @map("token_hash") @db.VarChar(255)
  purpose        token_purpose
  expiresAt      DateTime      @map("expires_at") @db.Timestamp(6)
  used_at        DateTime?     @db.Timestamp(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  attempts       Int           @default(0)
  lockedUntil    DateTime?     @map("locked_until") @db.Timestamp(6)
  invalidated_at DateTime?     @db.Timestamp(6)

  @@index([email, purpose], map: "idx_auth_tokens_email_purpose")
  @@index([email, purpose, createdAt], map: "idx_auth_tokens_email_purpose_created")
  @@map("auth_action_tokens")
}

model LoginAttempt {
  email        String    @db.VarChar(255)
  deviceId     String    @map("device_id") @db.VarChar(100)
  failed_count Int       @default(0)
  lockedUntil  DateTime? @map("locked_until") @db.Timestamp(6)
  updated_at   DateTime  @default(now()) @db.Timestamp(6)

  @@id([email, deviceId])
  @@map("login_attempts")
}

model Session {
  session_id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  deviceId          String?          @map("device_id") @db.VarChar(100)
  tokenHash         String           @unique @map("refresh_token_hash") @db.VarChar(255)
  audience          session_audience @default(storefront)
  login_method      auth_method
  userAgent         String?          @map("user_agent") @db.VarChar(500)
  ipAddress         String?          @map("ip_address") @db.VarChar(45)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  last_used_at      DateTime         @default(now()) @db.Timestamp(6)
  expiresAt         DateTime         @map("expires_at") @db.Timestamp(6)
  absoluteExpiresAt DateTime         @map("absolute_expires_at") @db.Timestamp(6)
  revoked_at        DateTime?        @db.Timestamp(6)
  revoke_reason     String?          @db.VarChar(50)

  @@index([deviceId], map: "idx_sessions_device_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([userId, deviceId], map: "idx_sessions_user_device")
  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model AuthRateLimit {
  key         String    @id @db.VarChar(400)
  count       Int       @default(0)
  windowStart DateTime  @map("window_start") @db.Timestamp(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamp(6)

  @@index([windowStart], map: "idx_auth_rate_limits_window_start")
  @@map("auth_rate_limits")
}

enum Role {
  MEMBER
  STAFF
  ADMIN
}

enum auth_method {
  password
  otp
  register
}

enum session_audience {
  storefront
  admin
}

enum token_purpose {
  register
  login
  reset_password
  guest_order_lookup
}

enum user_role {
  member
  admin
  staff
}

enum product_status {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum product_gender {
  nam
  nu
}

enum product_moment {
  work
  dinner
  event
  weekend
}

model Category {
  category_id String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  sortOrder   Int        @default(0) @map("sort_order")
  products    Product[]
  sizeChart   SizeChart?

  @@map("categories")
}

model Product {
  product_id      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  slug            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  typeLabel       String           @map("type_label") @db.VarChar(120)
  price           Decimal          @db.Decimal(12, 2)
  compareAtPrice  Decimal?         @map("compare_at_price") @db.Decimal(12, 2)
  badge           String?          @db.VarChar(20)
  description     String           @default("")
  material        String           @default("")
  care            String[]         @default([])
  fitSummary      String           @default("") @map("fit_summary")
  fitModel        String           @default("") @map("fit_model")
  looks           Json             @default("[]")
  coverMediaId    String           @map("cover_media_id") @db.VarChar(100)
  galleryMediaIds String[]         @map("gallery_media_ids")
  colorMedia      Json             @default("{}") @map("color_media")
  moments         product_moment[]
  genders         product_gender[]
  salesRank       Int              @map("sales_rank")
  displayOrder    Int              @map("display_order")
  searchText      String           @map("search_text")
  status          product_status   @default(DRAFT)
  createdAt       DateTime         @default(dbgenerated("CURRENT_DATE")) @map("created_at") @db.Date
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  category        Category         @relation(fields: [categoryId], references: [category_id], onDelete: Restrict)
  variants        ProductVariant[]

  @@index([categoryId], map: "idx_products_category")
  @@index([status, displayOrder, slug], map: "idx_products_status_order")
  @@index([moments], map: "idx_products_moments", type: Gin)
  @@index([genders], map: "idx_products_genders", type: Gin)
  @@map("products")
}

model ProductVariant {
  variant_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String   @unique @db.VarChar(64)
  size         String   @db.VarChar(10)
  colorName    String   @map("color_name") @db.VarChar(50)
  colorHex     String   @map("color_hex") @db.Char(7)
  inventoryQty Int      @default(0) @map("inventory_qty")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  product      Product  @relation(fields: [productId], references: [product_id], onDelete: Cascade)

  @@unique([productId, colorName, size], map: "uq_variants_product_color_size")
  @@map("product_variants")
}

model SizeChart {
  categoryId String   @id @map("category_id") @db.Uuid
  data       Json
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  category   Category @relation(fields: [categoryId], references: [category_id], onDelete: Cascade)

  @@map("size_charts")
}
