# Sao chép thành backend/.env và điền giá trị. KHÔNG commit .env. File này chỉ chứa tên biến.

NODE_ENV=development
PORT=4000

# Kết nối PostgreSQL cục bộ, vd. postgresql://postgres:<mật khẩu>@localhost:5432/nine2fine?schema=public.
# DIRECT_URL dùng cho prisma migrate; với Postgres cục bộ đặt giống DATABASE_URL.
DATABASE_URL=
DIRECT_URL=

# Số tầng reverse proxy tin cậy để lấy IP thật cho giới hạn tần suất (false | 1 | 2 ...)
TRUST_PROXY=false

# Danh sách Origin được gọi API, phân tách bằng dấu phẩy (dev: Angular http://localhost:4200)
CORS_ALLOWED_ORIGINS=
# lax (mặc định, cùng site) | strict | none (chỉ production, khác site)
COOKIE_SAMESITE=lax

# Bí mật băm mã OTP (HMAC-SHA256), tối thiểu 32 ký tự ngẫu nhiên. Thiếu thì máy chủ không khởi động.
OTP_HMAC_SECRET=

# Thư: smtp (Gmail SMTP, cần App Password) | dev-outbox (ghi file .eml vào backend/dev-outbox)
MAIL_MODE=dev-outbox
MAIL_OUTBOX_DIR=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
SUPPORT_EMAIL=

# Tài khoản seed (npm run seed). Mật khẩu theo BR-AUTH-20: 8-64 ký tự, có chữ in hoa và chữ số.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# Slice 9 (trả hàng). KHÔNG commit giá trị thật.
# Khoá mã hoá số tài khoản nhận hoàn: 32 byte ngẫu nhiên mã hoá base64 (vd. `openssl rand -base64 32`). Production thiếu thì tạo yêu cầu trả hàng COD báo không khả dụng.
RETURN_ACCOUNT_KEY=
# Ảnh minh chứng trả hàng (RIÊNG TƯ, chỉ xem qua route có kiểm quyền): db (mặc định, lưu bytea trong PostgreSQL,
# dùng chung với cả nhóm, không mất khi deploy) | local (ghi ra đĩa máy mình, chỉ để thử; production bị chặn).
RETURN_PHOTO_STORAGE=db
# Thư mục ảnh trả hàng khi RETURN_PHOTO_STORAGE=local (mặc định backend/.media-private).
RETURN_PHOTO_LOCAL_DIR=

# Chuyển khoản QR tự đối soát qua SePay (BR-CHK-21). KHÔNG commit giá trị thật.
# QR chỉ hiện khi đủ 4 biến dưới đây VÀ store_settings.bank_transfer_enabled = true.
# BANK_NAME: tên ngân hàng viết tắt mà SePay / VietQR nhận (vd. MBBank, Vietcombank, TPBank, ACB).
BANK_NAME=
BANK_ACCOUNT_NUMBER=
# Tên chủ tài khoản, chữ in hoa không dấu như trên ứng dụng ngân hàng.
BANK_ACCOUNT_NAME=
# API key tự đặt ở SePay > Webhooks (Kiểu chứng thực: API Key), tối thiểu 16 ký tự.
# URL webhook khai trên SePay: https://<miền-backend>/api/payments/sepay/webhook
SEPAY_WEBHOOK_KEY=
# Chế độ giả lập cho đồ án (không liên kết ngân hàng): true -> QR bật không cần SEPAY_WEBHOOK_KEY, thiếu BANK_* thì dùng
# tài khoản demo; trang QR có nút "Giả lập đã nhận tiền". KHÔNG bật khi nhận tiền thật.
PAYMENT_SIMULATOR=false

# Địa chỉ gốc của web (dùng dựng liên kết trong email). Dev: http://localhost:4200
APP_BASE_URL=

# Ảnh CÔNG KHAI admin tải lên (ảnh sản phẩm, banner trang chủ):
#   cloudinary (khuyên dùng: cả nhóm thấy chung, không mất khi deploy, phục vụ qua CDN) | local (ghi ra đĩa máy mình;
#   production bị chặn). DB chỉ lưu id ảnh, /api/media/{id} chuyển hướng tới Cloudinary.
MEDIA_STORAGE=local
# Khi MEDIA_STORAGE=cloudinary: chép "API environment variable" ở Cloudinary Console > Dashboard (Product Environment),
# dạng cloudinary://<api_key>:<api_secret>@<cloud_name>. KHÔNG commit giá trị thật.
CLOUDINARY_URL=
# Hoặc điền riêng 3 biến (dùng khi không có CLOUDINARY_URL):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục trên Cloudinary chứa ảnh (mặc định nine2fine). Mỗi người có thể đặt riêng nếu không muốn chung.
CLOUDINARY_FOLDER=
# Thư mục lưu ảnh khi MEDIA_STORAGE=local (mặc định backend/.media)
MEDIA_LOCAL_DIR=

# Chỉ khi chạy test backend (npm test): DB RIÊNG trên 127.0.0.1, tên n2f_test (mặc định postgresql://postgres@127.0.0.1:54329/n2f_test). Không bao giờ trỏ vào DB thật.
N2F_TEST_DB_URL=
