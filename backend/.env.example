# Sao chép thành backend/.env và điền giá trị. KHÔNG commit .env. File này chỉ chứa tên biến.

NODE_ENV=development
PORT=4000

# Kết nối PostgreSQL (Supabase). DATABASE_URL: pooler cho ứng dụng; DIRECT_URL: kết nối trực tiếp cho prisma migrate.
DATABASE_URL=
DIRECT_URL=

# Số tầng reverse proxy tin cậy để lấy IP thật cho giới hạn tần suất (false | 1 | 2 ...)
TRUST_PROXY=false

# Danh sách Origin được gọi API, phân tách bằng dấu phẩy (dev: Angular http://localhost:4200)
CORS_ALLOWED_ORIGINS=
# lax (mặc định, cùng site) | strict | none (chỉ production, khác site)
COOKIE_SAMESITE=lax

# Bí mật băm mã OTP (HMAC-SHA256), tối thiểu 32 ký tự ngẫu nhiên. Thiếu thì máy chủ không khởi động.
OTP_HMAC_SECRET=

# Thư: smtp (Gmail SMTP, cần App Password) | dev-outbox (ghi file .eml vào backend/dev-outbox)
MAIL_MODE=dev-outbox
MAIL_OUTBOX_DIR=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
SUPPORT_EMAIL=

# Tài khoản seed (npm run seed). Mật khẩu theo BR-AUTH-20: 8-64 ký tự, có chữ in hoa và chữ số.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=
SEED_STAFF_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# Slice 9 (trả hàng). KHÔNG commit giá trị thật.
# Khoá mã hoá số tài khoản nhận hoàn: 32 byte ngẫu nhiên mã hoá base64 (vd. `openssl rand -base64 32`). Production thiếu thì tạo yêu cầu trả hàng COD báo không khả dụng.
RETURN_ACCOUNT_KEY=
# Bucket Supabase RIÊNG TƯ cho ảnh trả hàng (mặc định return-photos; Public bucket phải TẮT, khác SUPABASE_STORAGE_BUCKET).
SUPABASE_RETURN_BUCKET=
# Thư mục ảnh trả hàng khi MEDIA_STORAGE=local (mặc định backend/.media-private).
RETURN_PHOTO_LOCAL_DIR=
