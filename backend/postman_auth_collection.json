{
  "info": {
    "name": "Nine2Fine - Auth API Collection",
    "description": "Bộ sưu tập Postman kiểm thử trọn bộ module Auth cho đồ án Nine2Fine (Đăng ký, Đăng nhập, OTP, Đặt lại mật khẩu)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/auth",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Kiểm tra tài khoản email (Check Email)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/check-email",
          "host": ["{{baseUrl}}"],
          "path": ["check-email"]
        },
        "description": "Kiểm tra xem email đã đăng ký chưa và đã có mật khẩu hay chưa để Frontend điều hướng màn hình phù hợp."
      }
    },
    {
      "name": "2. Gửi mã OTP - Đăng ký (Send OTP - Register)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"purpose\": \"register\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["send-otp"]
        },
        "description": "Gửi mã OTP 8 chữ số để đăng ký tài khoản (giới hạn 60s/lần, tối đa 5 lần trong 30 phút)."
      }
    },
    {
      "name": "3. Đăng ký tài khoản (Register)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"otp\": \"12345678\",\n  \"first_name\": \"Nguyễn\",\n  \"last_name\": \"Văn A\",\n  \"date_of_birth\": \"2003-05-15\",\n  \"accepted_terms\": true,\n  \"marketing_opt_in\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        },
        "description": "Xác thực OTP và tạo tài khoản với role MEMBER (không cần mật khẩu theo tài liệu)."
      }
    },
    {
      "name": "4. Gửi mã OTP - Đăng nhập (Send OTP - Login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"purpose\": \"login\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/send-otp",
          "host": ["{{baseUrl}}"],
          "path": ["send-otp"]
        },
        "description": "Gửi OTP đăng nhập nhanh cho tài khoản đã tồn tại."
      }
    },
    {
      "name": "5. Đăng nhập bằng OTP (Login OTP)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"otp\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login-otp",
          "host": ["{{baseUrl}}"],
          "path": ["login-otp"]
        },
        "description": "Đăng nhập bằng OTP, trả về JWT Access Token."
      }
    },
    {
      "name": "6. Đăng nhập bằng mật khẩu (Login Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Device-Id",
            "value": "pc-chrome-uuid-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"password\": \"MatKhau@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        },
        "description": "Đăng nhập bằng mật khẩu. Nhập sai 5 lần liên tiếp sẽ khóa thiết bị 15 phút (LOGIN-05)."
      }
    },
    {
      "name": "7. Quên mật khẩu (Forgot Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["forgot-password"]
        },
        "description": "Yêu cầu mã OTP đặt lại mật khẩu (hoặc thiết lập mật khẩu lần đầu cho tài khoản chưa có pass)."
      }
    },
    {
      "name": "8. Đặt lại mật khẩu (Reset Password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sinhvien@uel.edu.vn\",\n  \"otp\": \"12345678\",\n  \"new_password\": \"MatKhauMoi@123\",\n  \"confirm_password\": \"MatKhauMoi@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["reset-password"]
        },
        "description": "Nhập mã OTP và cập nhật mật khẩu mới (kiểm tra khớp 2 mật khẩu trước khi check OTP)."
      }
    },
    {
      "name": "9. Đăng xuất (Logout)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/logout",
          "host": ["{{baseUrl}}"],
          "path": ["logout"]
        },
        "description": "Thu hồi token và hủy phiên đăng nhập của người dùng."
      }
    }
  ]
}
