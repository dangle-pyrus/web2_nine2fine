{
  "info": {
    "name": "Nine2Fine - Auth API (Slice 1, locked contract)",
    "description": "Cookie phiên HttpOnly do Postman cookie jar tự giữ. Mọi yêu cầu ghi cần Origin thuộc CORS_ALLOWED_ORIGINS và X-Requested-With: n2f. Mã OTP xem trong backend/dev-outbox/*.eml.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    },
    {
      "key": "origin",
      "value": "http://localhost:4200",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Tra cứu email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/lookup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"minh@example.com\"\n}"
        }
      }
    },
    {
      "name": "2. Gửi mã (login | register | reset-password)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/codes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"minh@example.com\",\n  \"purpose\": \"login\"\n}"
        }
      }
    },
    {
      "name": "3. Đăng nhập bằng mã",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/login/code",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"minh@example.com\",\n  \"code\": \"00000000\"\n}"
        }
      }
    },
    {
      "name": "4. Đăng nhập bằng mật khẩu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/login/password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"minh@example.com\",\n  \"password\": \"\"\n}"
        }
      }
    },
    {
      "name": "5. Đăng ký",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"new@example.com\",\n  \"code\": \"00000000\",\n  \"firstName\": \"Minh\",\n  \"lastName\": \"Nguyễn Văn\",\n  \"birthDate\": null,\n  \"marketingOptIn\": false,\n  \"acceptedTerms\": true\n}"
        }
      }
    },
    {
      "name": "6. Đặt lại mật khẩu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/password/reset",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"minh@example.com\",\n  \"code\": \"00000000\",\n  \"newPassword\": \"\"\n}"
        }
      }
    },
    {
      "name": "7. Phiên hiện tại",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "8. Đăng xuất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "9. Admin - đăng nhập",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/admin/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@nine2fine.test\",\n  \"password\": \"\"\n}"
        }
      }
    },
    {
      "name": "10. Admin - phiên hiện tại",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/admin/auth/me"
      }
    },
    {
      "name": "11. Admin - đăng xuất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "X-Requested-With",
            "value": "n2f"
          }
        ],
        "url": "{{baseUrl}}/admin/auth/logout"
      }
    }
  ]
}
