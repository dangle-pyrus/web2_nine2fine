# =============================================================================
# FILE CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENV CONFIG)
# Đổi tên file này thành .env hoặc tạo file .env với các giá trị bên dưới
# =============================================================================

PORT=5000

# -----------------------------------------------------------------------------
# KẾT NỐI SUPABASE POSTGRESQL (Lấy tại: Supabase Dashboard -> Project Settings -> Database)
# -----------------------------------------------------------------------------
# Dùng cho chế độ Transaction Pooler (Port 6543)
DATABASE_URL=""

# Dùng cho kết nối trực tiếp Session mode khi chạy Prisma Migration (Port 5432)
DIRECT_URL=""

# -----------------------------------------------------------------------------
# CẤU HÌNH JSON WEB TOKEN (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

